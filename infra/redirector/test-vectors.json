    {
      "name": "128-hex encrypted ref uses two labels, most-significant chunk first",
      "ref": "8f1d385f2493d4bcd4d3b2c1e3c1b8f7d1a09876543210fedcba98765432abcd0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "labels": [
        "3kescpgjpg23w0jk9ccszdtmgq3mcqnthwg1oxbfcnb6w68t71",
        "10r2curot7aoi80l0gyf25bl7y111lpgrb8bzoi8f0c1uhmgf"
