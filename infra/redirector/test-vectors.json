  "escaping": [
    { "name": "a.b", "label": "a-b" },
    { "name": "a-b", "label": "a--b" },
    { "name": "a--b", "label": "a----b" },
    { "name": "a-b.c-d", "label": "a--b-c--d" },
    { "name": "a---b.c", "label": "a------b-c" },
    { "name": "x", "label": "x" },
    { "name": "foo-bar.swarm.eth", "label": "foo--bar-swarm-eth" },
    { "name": "en.wikipedia-on-ipfs.org", "label": "en-wikipedia--on--ipfs-org" }
  ],

  "rejects": [
    { "host": "example.com", "why": "not a virtual suffix" },
    { "host": "freedom.baby", "why": "the base domain itself carries no label" },
    { "host": "bzz.freedom.baby", "why": "namespace with no label" },
    { "host": "3kescpgjpg23w0jk9ccszdtmgq3mcqnthwg1oxbfcnb6w68t71.zzz.freedom.baby", "why": "unknown namespace" },
    { "host": "a.b.c.bzz.freedom.baby", "why": "bzz takes at most two labels" },
    { "host": "NOT-hex!.bzz.freedom.baby", "why": "label is not lowercase base36" },
    { "host": "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz.bzz.freedom.baby", "why": "decodes to more than 32 bytes" }
  ]
