      "redirect": "https://gateway.ethswarm.org/bzz/8f1d385f2493d4bcd4d3b2c1e3c1b8f7d1a09876543210fedcba98765432abcd0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef/x"
    },
    {
      "name": "leading zero bytes encode as leading '0' chars (multibase convention)",
      "ref": "000000002493d4bcd4d3b2c1e3c1b8f7d1a09876543210fedcba98765432abcd",
      "labels": ["0000gmt7pg0m47sf3innkz4sz73gbzf2xzswf47xjt5q025"],
