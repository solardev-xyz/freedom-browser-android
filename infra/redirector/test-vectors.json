{
  "_comment": [
    "Cross-implementation vectors for the virtual-origin label encodings.",
    "",
    "Two implementations must agree on these forever: the app's mapping",
    "module (app/src/main/java/baby/freedom/mobile/browser/VirtualOrigin.kt)",
    "and the redirector in this directory. Both are pinned here:",
    "  - node infra/redirector/redirector.test.js  loads this file directly",
    "  - VirtualOriginVectorsTest.kt mirrors it literally (no JSON parser on",
    "    the unit-test classpath) and fails if either side moves.",
    "Change a value here and you must change it in all three places.",
    "",
    "`redirect` is what the redirector 301s to with the default gateways",
    "below; `display` is what the app shows in the address bar for the",
    "same host + path."
  ],
  "baseDomain": "freedom.baby",
  "gateways": {
    "swarmGateway": "https://gateway.ethswarm.org",
    "ipfsGatewayHost": "dweb.link",
    "ipnsGatewayHost": "dweb.link",
    "ensGatewaySuffix": "limo"
  },

  "bzz": [
