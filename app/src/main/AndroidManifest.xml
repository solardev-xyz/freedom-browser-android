<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The wallet's BiometricPrompt unlock (#76): fingerprint/face or the screen lock. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Tapjacking protection (#240): hide other apps' overlay windows while a
      wallet approval or confirmation is on screen (Android 12+). Normal
      permission, no prompt.
    -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!--
      Site permissions (#81). Requested at runtime only after the user
      has allowed a specific site to use the capability — never at
      launch. MODIFY_AUDIO_SETTINGS is what WebRTC needs to route call
      audio (normal permission, no prompt).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      A Ledger over Bluetooth LE (#142), asked for on the Connect a Ledger
      page only. Android 12+: Nearby devices, never used for location.
      Android 11: the legacy Bluetooth permissions plus location (above),
      which BLE scanning needs there.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- …and none of that hardware is required to install the browser. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Freedom"
        android:usesCleartextTraffic="true">

        <!--
          `configChanges` keeps the Activity (and with it every tab's
          WebView) alive across rotation, fold/unfold, keyboard, locale
          and theme changes. Without it Android recreates the Activity
          on each of these, and since the WebViews are built with the
          Activity context and live in Compose `remember`, recreation
          throws away every page: scroll, form input, JS state, playback
          position. Compose reads LocalConfiguration / LocalDensity
          live, so the UI relayouts without a restart.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale|density|colorMode"
            android:theme="@style/Theme.Freedom"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Links, shares and searches from other apps (#268) arrive here,
          not at MainActivity: this invisible activity hands the link or
          query on to the browser's own task and finishes (see
          IncomingLinkActivity for why).
        -->
        <activity
            android:name=".IncomingLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">

            <!--
              Any http(s) link, so Freedom can be the default browser
              (RoleManager.ROLE_BROWSER wants a filter for every web URL:
              scheme only, no host).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- The dweb schemes the address bar opens. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bzz" />
                <data android:scheme="ipfs" />
                <data android:scheme="ipns" />
                <data android:scheme="ens" />
                <data android:scheme="rad" />
            </intent-filter>

            <!--
              App Links for the virtual origins (see VirtualOrigin.kt).
              A share link copied out of a dweb page is a real https URL
              on a domain we own; on a device with Freedom installed it
              should open here at the same content instead of round-
              tripping through the public-gateway redirector.

              The wildcard hosts mirror VirtualOrigin.SUFFIXES exactly.
              Verification is done against the host minus the wildcard,
              so `assetlinks.json` is fetched from the four bare
              namespace domains — see infra/applinks/README.md.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="*.bzz.freedom.baby" />
                <data android:host="*.ipfs.freedom.baby" />
                <data android:host="*.ipns.freedom.baby" />
                <data android:host="*.ens.freedom.baby" />
            </intent-filter>

            <!-- Share → Freedom: a link opens, other text is searched for. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- The text-selection menu in other apps. -->
            <intent-filter android:label="@string/search_with_app">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Serves camera captures for <input type=file capture> — the
          camera app writes the photo into it, the page reads it back
          (see FileChooser.kt) — and the page context menu's Copy image /
          Share image files (see ImageActions.kt). Scoped to
          cache/uploads/ and cache/shared/ only (res/xml/file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The download notifications' Pause / Resume / Cancel (#265). -->
        <receiver
            android:name=".browser.DownloadActionReceiver"
            android:exported="false" />

        <!--
          NodeService lives in its own `:node` process so we can exit
          that process (and everything native inside it — ant's tokio
          runtime, the freedom-ipfs store) when the user toggles the node
          off, without tearing down the UI.
        -->
        <service
            android:name=".node.NodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":node" />

        <!--
          The Myotis light client (#72) runs in its own `:myotis` process:
          independent of the Swarm toggle that kills `:node`, and exited
          when the user switches it off. Bound-only — see MyotisService.
        -->
        <service
            android:name=".node.MyotisService"
            android:exported="false"
            android:process=":myotis" />

        <!--
          The embedded Tor client (#143, Arti) runs in its own `:tor`
          process: independent of the Swarm toggle, exited when the user
          stops Tor, and a fault in it can't take the browser down.
          Bound-only — see TorService.
        -->
        <service
            android:name=".node.TorService"
            android:exported="false"
            android:process=":tor" />

        <!--
          Google backup (#231): keeps the Block Store entry's cloud copy
          end-to-end encrypted while the app isn't open. See PhraseBackupJob.
        -->
        <service
            android:name=".wallet.PhraseBackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          The recovery phrase's clipboard clear (#78) when the process
          died within its minute: see PhraseClipboard. Only our own
          AlarmManager PendingIntent reaches it.
        -->
        <receiver
            android:name=".browser.PhraseClipboard$ClearReceiver"
            android:exported="false" />

    </application>
</manifest>
