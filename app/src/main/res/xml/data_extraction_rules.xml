<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (targetSdk 31+): what cloud backup and device-to-device
  transfer may copy. `allowBackup="false"` already turns cloud backup off,
  but not device transfer, so the keyed RPC providers' API keys
  (RpcKeyStore, `datastore/freedom_rpc_secrets.preferences_pb`) are
  excluded here from both. They're encrypted under an Android Keystore
  key that never leaves this device, so a copy would be unreadable
  anyway. (Builds before that store kept them in plain text in
  `freedom_node_settings`; MainActivity moves them out on start.)
  So are the stores that let a site act on the wallet or the node without
  asking: connected sites (DappGrantStore), auto-approve rules
  (AutoApproveStore), x402 allowances (X402Store), Swarm grants
  (SwarmGrantStore) and Radicle grants (RadicleGrantStore: a signing
  grant names the wallet's Radicle DID, which the same phrase derives
  again). The wallet itself never travels, so on a new phone these would
  come back silently once the same phrase is imported there, never
  granted on that device (#229). The Swarm permission manifests' record
  (`swarm-manifests.json`, SwarmManifests) stays with the Swarm grants it
  says it owns: without them a copy would claim grants the user later
  makes by hand on the new phone, and turn them off when the app's
  manifest drops the row.
  The nodes' own device-only keys stay too: ant's `ant/identity.json`
  (signing key, overlay nonce, libp2p key pair, used when there's no
  wallet identity) and the Radicle profile's `radicle/keys` (its NID
  when there's no wallet Radicle identity). Copied, two phones would run
  one Swarm overlay or Radicle node and both sign as it. Left behind,
  each node makes a fresh key on the new phone (ant writes a new
  identity.json and account.json; libradicle's `start` makes a new key
  pair when `keys/radicle` is missing, as after Remove wallet).
  The wallet vault (KeystoreVaultStore) needs no rule: it lives in
  `noBackupFilesDir` (`no_backup/wallet/vault.json`), which no backup
  domain includes, under its own Keystore key (`freedom.wallet.vault`,
  distinct from the API keys' `freedom_rpc_api_keys`).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/freedom_rpc_secrets.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_dapp_grants.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_dapp_auto_approve.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_x402.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_swarm_grants.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_radicle_grants.preferences_pb" />
        <exclude domain="file" path="swarm-manifests.json" />
        <exclude domain="file" path="ant/identity.json" />
        <exclude domain="file" path="radicle/keys" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/freedom_rpc_secrets.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_dapp_grants.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_dapp_auto_approve.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_x402.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_swarm_grants.preferences_pb" />
        <exclude domain="file" path="datastore/freedom_radicle_grants.preferences_pb" />
        <exclude domain="file" path="swarm-manifests.json" />
        <exclude domain="file" path="ant/identity.json" />
        <exclude domain="file" path="radicle/keys" />
    </device-transfer>
</data-extraction-rules>
