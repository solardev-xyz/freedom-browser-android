<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower (`fullBackupContent`): the same exclusions as
  data_extraction_rules.xml: the encrypted RPC API keys, the stores
  that let a site act on the wallet or node without asking (#229), and
  the Swarm permission manifests' record of which of those grants it owns,
  and the embedded nodes' data dirs (ant, radicle, ipfs, tor and the
  Swarm deposit hold), which hold each node's own identity (#338). Backup is off
  (`allowBackup="false"`); this keeps them out should that ever change.
  The wallet vault (KeystoreVaultStore) needs no rule: it lives in
  `noBackupFilesDir` (`no_backup/wallet/vault.json`), which no backup
  domain includes, under its own Keystore key (`freedom.wallet.vault`,
  distinct from the API keys' `freedom_rpc_api_keys`).
-->
<full-backup-content>
    <exclude domain="file" path="datastore/freedom_rpc_secrets.preferences_pb" />
    <exclude domain="file" path="datastore/freedom_dapp_grants.preferences_pb" />
    <exclude domain="file" path="datastore/freedom_dapp_auto_approve.preferences_pb" />
    <exclude domain="file" path="datastore/freedom_x402.preferences_pb" />
    <exclude domain="file" path="datastore/freedom_swarm_grants.preferences_pb" />
    <exclude domain="file" path="datastore/freedom_radicle_grants.preferences_pb" />
    <exclude domain="file" path="swarm-manifests.json" />
    <exclude domain="file" path="ant" />
    <exclude domain="file" path="unconfirmed-deposit.json" />
    <exclude domain="file" path="radicle" />
    <exclude domain="file" path="ipfs" />
    <exclude domain="file" path="tor" />
</full-backup-content>
