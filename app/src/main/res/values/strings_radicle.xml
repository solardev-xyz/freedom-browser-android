    <!-- RadiclePrompt.kt: the window.radicle consent prompt (under the site's name) -->
    <string name="radicle_prompt_connect_request">wants to connect to your Radicle node</string>
    <string name="radicle_prompt_connect_detail">It will see whether your node is running and which repositories you seed, and can ask to seed or stop seeding repositories. It can\'t write anything as you unless you allow that separately.</string>
    <string name="radicle_prompt_connect_allow">Connect</string>
    <string name="radicle_prompt_seed_request">wants to seed a repository</string>
    <string name="radicle_prompt_seed_detail">Your node will fetch it now, keep a copy and share it with other peers, using storage and data for as long as you seed it.</string>
    <string name="radicle_prompt_seed_allow">Seed</string>
    <string name="radicle_prompt_unseed_request">wants to stop seeding a repository</string>
    <string name="radicle_prompt_unseed_detail">Your node will stop sharing it and drop it from your seeded list.</string>
    <string name="radicle_prompt_unseed_allow">Stop seeding</string>
    <string name="radicle_prompt_signing_request">wants to act as you on Radicle</string>
    <string name="radicle_prompt_signing_changed_request">wants to act as your new Radicle identity</string>
    <string name="radicle_prompt_signing_changed_detail">You allowed it to act as another identity (%1$s). Your Radicle identity has changed since then: allowing this also shows it the one above, so it can link the two. It can then open issues, comment and change issue states signed with this key, without asking again. What it writes is published to the network under your name and can\'t be taken back.</string>
    <string name="radicle_prompt_signing_changed_detail_device">You allowed it to act as this device\'s own Radicle identity. Your Radicle identity has changed since then: allowing this also shows it the one above, so it can link the two. It can then open issues, comment and change issue states signed with this key, without asking again. What it writes is published to the network under your name and can\'t be taken back.</string>
    <string name="radicle_prompt_identity_wallet">Your wallet\'s identity (the same on any device with your recovery phrase)</string>
    <string name="radicle_prompt_identity_own">This device\'s own identity</string>
    <string name="radicle_prompt_signing_detail">It will see your Radicle identity (DID and node ID) and can open issues, comment and change issue states signed with your key, without asking again. What it writes is published to the network under your name and can\'t be taken back.</string>

