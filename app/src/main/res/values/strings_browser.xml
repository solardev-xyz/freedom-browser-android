    <string name="browser_explore_swarmit_subtitle">Decentralized social feed on Swarm</string>
    <string name="browser_intro_title">Welcome to Freedom</string>
    <string name="browser_intro_body_web">Freedom opens the web you know and the decentralized web: sites stored on Swarm (bzz://) and IPFS (ipfs://), and ENS names such as app.swarmit.eth.</string>
    <string name="browser_intro_body_nodes">It reaches them through its own nodes, running on this phone and talking straight to peers. The nodes use data and battery while they run; Nodes &amp; networks in the menu shows how they\'re doing and can switch them off.</string>
    <string name="browser_intro_body_wallet">You don\'t need a wallet to browse. If you want one later, open Wallet from the menu.</string>
    <string name="browser_intro_got_it">Got it</string>
    <!-- %1$s is the name of a curated site, e.g. "Swarmit". -->
    <string name="browser_intro_try">Try %1$s</string>
    <string name="browser_warmup_starting">Starting your Swarm node…</string>
    <string name="browser_warmup_starting_detail">Swarm sites open once it has found peers.</string>
    <string name="browser_warmup_connecting">Your Swarm node is looking for peers…</string>
    <string name="browser_warmup_connecting_detail">Swarm sites open once it has found some.</string>
    <string name="browser_warmup_failed">Your Swarm node ran into a problem</string>
    <string name="browser_warmup_failed_detail">Tap for details and to try again.</string>
    <string name="browser_warmup_open_node_details">Open node details</string>
    <!-- %1$s is a version number, e.g. "0.6.11". -->
    <string name="browser_update_available">Freedom %1$s is available</string>
    <string name="browser_update_body">A newer version of this browser is out. Its release page has the APK and what changed.</string>
    <string name="browser_update_view_release">View release</string>
    <string name="browser_update_close">Close the notice for Freedom %1$s</string>
    <string name="browser_home_hero">The decentralized web is here. Powered by built-in nodes, this browser connects you directly to peers, keeping the network strong and user-controlled.</string>
    <string name="browser_private_home_title">Private tab</string>
    <string name="browser_private_home_body">Pages you open in private tabs aren\'t kept in your history, and their cookies, site data and cache are deleted when you close your last private tab. Site permissions and zoom levels you set here last only until then too.</string>
    <string name="browser_private_home_still_saved">Downloaded files and bookmarks you add are still saved. So is Swarm and IPFS content you open: your Swarm and IPFS nodes keep what they fetch in their own storage on this device, for private tabs too.</string>
    <string name="browser_private_home_limits_header">What private tabs don\'t do</string>
    <string name="browser_private_home_limits">This is privacy on this device, not anonymity. Sites you sign in to still know it\'s you, your network operator can still see your traffic, Swarm and IPFS peers still see your nodes\' requests, and your IP address stays visible to sites and peers.</string>

